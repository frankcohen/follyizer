[Unit]
Description=Follyizer persistent Meshtastic bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fpp
Group=fpp
WorkingDirectory=/home/fpp/follyizer
ExecStart=/home/fpp/follyizer/.venv/bin/python -m follyizer.app --config /home/fpp/follyizer/config.yaml
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
